{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // whisper.rn's package.json exports only subpaths ("./*"), not its root,
      // so TypeScript can't resolve `import … from 'whisper.rn'` on its own.
      // Metro falls back to its "main" at runtime.
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "web", "siteiq-backend"]
}
